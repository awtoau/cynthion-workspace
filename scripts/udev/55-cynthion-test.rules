# Test bitstreams built in this workspace: one product ID each.
#
# GENERATED by scripts/install_udev.py from ecp5-test/usb_ids.py.
# Edit that file and re-run, rather than editing this one.
#
# uaccess ONLY. Deliberately no SYMLINK: a symlink is a second name for the device, and a
# second name is another thing that can be stale or point elsewhere. Code resolves devices
# by VID:PID from sysfs, which is the identity the device reports about itself. These
# rules exist purely to make the device openable without root -- a device outside the
# granted set enumerates fine and then fails to open, which looks exactly like dead
# gateware.


# USB devices.
SUBSYSTEM=="usb", ATTR{idVendor}=="1d50", ATTR{idProduct}=="6180", TAG+="uaccess"   # riscv_console
SUBSYSTEM=="usb", ATTR{idVendor}=="1d50", ATTR{idProduct}=="6181", TAG+="uaccess"   # usb_serial
SUBSYSTEM=="usb", ATTR{idVendor}=="1d50", ATTR{idProduct}=="6182", TAG+="uaccess"   # usb_bulk
SUBSYSTEM=="usb", ATTR{idVendor}=="1d50", ATTR{idProduct}=="6183", TAG+="uaccess"   # usb_timing
SUBSYSTEM=="usb", ATTR{idVendor}=="1d50", ATTR{idProduct}=="6184", TAG+="uaccess"   # bitstream_sink
SUBSYSTEM=="usb", ATTR{idVendor}=="1d50", ATTR{idProduct}=="6185", TAG+="uaccess"   # led_patterns
SUBSYSTEM=="usb", ATTR{idVendor}=="1d50", ATTR{idProduct}=="6186", TAG+="uaccess"   # riscv_vex_console
SUBSYSTEM=="usb", ATTR{idVendor}=="1d50", ATTR{idProduct}=="6187", TAG+="uaccess"   # riscv_bench
SUBSYSTEM=="usb", ATTR{idVendor}=="1d50", ATTR{idProduct}=="6188", TAG+="uaccess"   # usb_oneway
SUBSYSTEM=="usb", ATTR{idVendor}=="1d50", ATTR{idProduct}=="6189", TAG+="uaccess"   # led_gateware

# The tty interfaces some of them expose. SUBSYSTEM=="tty" matches the
# interface, so vendor/product come from the parent device and need ATTRS.
SUBSYSTEM=="tty", ATTRS{idVendor}=="1d50", ATTRS{idProduct}=="6180", TAG+="uaccess"   # riscv_console
SUBSYSTEM=="tty", ATTRS{idVendor}=="1d50", ATTRS{idProduct}=="6181", TAG+="uaccess"   # usb_serial
SUBSYSTEM=="tty", ATTRS{idVendor}=="1d50", ATTRS{idProduct}=="6186", TAG+="uaccess"   # riscv_vex_console
