  process $36
    assign $14 [0] 1'0
    switch \fsm_state [3:0]
      case 4'0000
      case 4'0001
        switch $1 [0]
          case 1'1
            assign $14 [0] 1'1
        end
      case 4'0011
        assign $14 [0] 1'1
        switch { \ulpi_next [0] \ulpi_dir [0] }
          case 2'-1
            assign $14 [0] 1'0
          case 2'1-
            assign $14 [0] 1'0
        end
      case 4'0100
      case 4'0101
      case 4'0010
        switch $3 [0]
          case 1'1
            assign $14 [0] 1'1
        end
      case 4'0110
        assign $14 [0] 1'1
        switch { \ulpi_next [0] \ulpi_dir [0] }
          case 2'-1
            assign $14 [0] 1'0
          case 2'1-
        end
      case 4'0111
        assign $14 [0] 1'1
        switch { \ulpi_next [0] \ulpi_dir [0] }
          case 2'-1
            assign $14 [0] 1'0
          case 2'1-
        end
      case 4'1000
        switch \ulpi_dir [0]
          case 1'1
            assign $14 [0] 1'0
          case
            assign $14 [0] 1'0
        end
    end
    switch \usb_rst [0]
      case 1'1
        assign $14 [0] 1'0
    end
  end

