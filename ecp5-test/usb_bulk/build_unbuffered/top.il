            assign $20 [3:0] 4'0010
          case 2'1-
            assign $20 [3:0] 4'1000
        end
      case 4'1000
        switch \ulpi_dir [0]
          case 1'1
            assign $20 [3:0] 4'0010
          case
            assign $20 [3:0] 4'0000
        end
    end
    switch \usb_rst [0]
