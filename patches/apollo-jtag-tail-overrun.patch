diff --git a/firmware/test/test_fpga_adv_crc.c b/firmware/test/test_fpga_adv_crc.c
new file mode 100644
index 0000000..1f32f99
--- /dev/null
+++ b/firmware/test/test_fpga_adv_crc.c
@@ -0,0 +1,83 @@
+/**
+ * Host-native test of fpga_adv_crc8 (src/fpga_adv_crc.h): CRC-8/ATM, polynomial 0x07,
+ * init 0, no reflection. Checked against the standard check value and an independent
+ * table-driven implementation, so the bitwise loop the firmware ships is the one tested.
+ *
+ * SPDX-License-Identifier: BSD-3-Clause
+ */
+
+#include <stdio.h>
+#include <stdint.h>
+#include <string.h>
+
+#include "fpga_adv_crc.h"
+
+static int failures = 0;
+
+#define CHECK(cond, ...)                                                       \
+	do {                                                                       \
+		if (cond) { printf("  ok   - "); }                                     \
+		else { printf("  FAIL - "); failures++; }                              \
+		printf(__VA_ARGS__);                                                   \
+		printf("\n");                                                          \
+	} while (0)
+
+static uint8_t table[256];
+
+static void build_table(void)
+{
+	for (int i = 0; i < 256; i++) {
+		uint8_t crc = (uint8_t)i;
+		for (int bit = 0; bit < 8; bit++) {
+			crc = (crc & 0x80) ? (uint8_t)((crc << 1) ^ 0x07) : (uint8_t)(crc << 1);
+		}
+		table[i] = crc;
+	}
+}
+
+static uint8_t reference(const uint8_t *data, uint8_t length)
+{
+	uint8_t crc = 0;
+	for (uint8_t i = 0; i < length; i++) {
+		crc = table[crc ^ data[i]];
+	}
+	return crc;
+}
+
+int main(void)
+{
+	build_table();
+
+	const uint8_t check[] = "123456789";
+	CHECK(fpga_adv_crc8(check, 9) == 0xF4, "CRC-8/ATM of \"123456789\" is 0xF4 (got 0x%02X)", fpga_adv_crc8(check, 9));
+	CHECK(fpga_adv_crc8(check, 0) == 0x00, "an empty buffer gives 0x00");
+
+	int bad_single = 0;
+	for (int value = 0; value < 256; value++) {
+		uint8_t byte = (uint8_t)value;
+		if (fpga_adv_crc8(&byte, 1) != reference(&byte, 1)) bad_single++;
+	}
+	CHECK(bad_single == 0, "all 256 single-byte inputs match the table implementation (%d differ)", bad_single);
+
+	// Frame shapes the link uses: 3-byte replies and longer buffers, pseudo-random content.
+	int bad_buffers = 0;
+	uint32_t state = 0x12345678u;
+	for (int round = 0; round < 2000; round++) {
+		uint8_t buffer[18];
+		uint8_t length = (uint8_t)(1 + round % 18);
+		for (int i = 0; i < length; i++) {
+			state = state * 1664525u + 1013904223u;
+			buffer[i] = (uint8_t)(state >> 24);
+		}
+		if (fpga_adv_crc8(buffer, length) != reference(buffer, length)) bad_buffers++;
+	}
+	CHECK(bad_buffers == 0, "2000 buffers of 1..18 bytes match the table implementation (%d differ)", bad_buffers);
+
+	// A frame followed by its CRC checks to zero (the property the receiver relies on).
+	uint8_t frame[4] = { 0xC1, 0x14, 0x01, 0 };
+	frame[3] = fpga_adv_crc8(frame, 3);
+	CHECK(fpga_adv_crc8(frame, 4) == 0x00, "a frame plus its CRC checks to zero");
+
+	printf(failures ? "FAILED\n" : "all passed\n");
+	return failures != 0;
+}
diff --git a/firmware/test/test_jtag_scan_tail.c b/firmware/test/test_jtag_scan_tail.c
new file mode 100644
index 0000000..d29e904
--- /dev/null
+++ b/firmware/test/test_jtag_scan_tail.c
@@ -0,0 +1,194 @@
+/**
+ * Host-native regression test of the real jtag.c: where a scan's bit-banged tail stores TDO.
+ *
+ * jtag.c is compiled in (so its statics are visible) against stub headers and fake SPI / TAP
+ * functions. The fake jtag_tap_shift records the output pointer it is given. Every pointer must be
+ * NULL (scan discards TDO) or inside the 1024-byte `comms` region.
+ *
+ * Before the fix the destination was jtag_in_buffer + (bytes - 1) for every scan: a 692-byte final
+ * chunk stored past the region, onto the USB control struct's callback pointer on the board.
+ * JTAG_SRC selects the file under test (default src/jtag.c); the test is run against the pre-fix
+ * file to show it fails there.
+ *
+ * SPDX-License-Identifier: BSD-3-Clause
+ */
+
+#include <stdio.h>
+#include <string.h>
+#include "vendor_requests.h"
+
+#ifndef JTAG_SRC
+#define JTAG_SRC "../src/jtag.c"
+#endif
+#include JTAG_SRC
+
+static int failures = 0;
+
+#define CHECK(cond, ...)                                                       \
+	do {                                                                       \
+		if (cond) { printf("  ok   - "); }                                     \
+		else { printf("  FAIL - "); failures++; }                              \
+		printf(__VA_ARGS__);                                                   \
+		printf("\n");                                                          \
+	} while (0)
+
+// --- fakes ---------------------------------------------------------------------------------
+
+static uint8_t *tap_output;
+static uint32_t tap_bits;
+static int tap_calls;
+
+void jtag_tap_shift(uint8_t *input_data, uint8_t *output_data, uint32_t data_bits, bool must_end)
+{
+	(void)input_data; (void)must_end;
+	tap_output = output_data;
+	tap_bits = data_bits;
+	tap_calls++;
+}
+
+uint32_t board_millis(void) { return 0; }
+void fpga_set_online(bool online) { (void)online; }
+uint8_t jtag_current_state(void) { return 0; }
+void jtag_deinit(void) {}
+void jtag_init(void) {}
+void jtag_go_to_state(unsigned state) { (void)state; }
+void jtag_wait_time(uint32_t microseconds) { (void)microseconds; }
+void led_set_override(uint8_t value) { (void)value; }
+void spi_configure_pinmux(spi_target_t target) { (void)target; }
+void spi_release_pinmux(spi_target_t target) { (void)target; }
+void spi_init(spi_target_t target, bool lsb_first, bool configure_pinmux, uint8_t baud_divider,
+              uint8_t clock_polarity, uint8_t clock_phase)
+{ (void)target; (void)lsb_first; (void)configure_pinmux; (void)baud_divider; (void)clock_polarity; (void)clock_phase; }
+static uint8_t *spi_rx;
+static size_t spi_rx_len;
+void spi_send(spi_target_t port, void *data_to_send, void *data_received, size_t length)
+{ (void)port; (void)data_to_send; spi_rx = data_received; spi_rx_len = length; }
+bool spi_send_async(spi_target_t port, void *data_to_send, void *data_received, size_t length)
+{ (void)port; (void)data_to_send; spi_rx = data_received; spi_rx_len = length; return true; }
+bool spi_send_done(void) { return true; }
+bool tud_control_xfer(uint8_t rhport, tusb_control_request_t const *request, void *buffer, uint16_t len)
+{ (void)rhport; (void)request; (void)buffer; (void)len; return true; }
+
+// --- the test ------------------------------------------------------------------------------
+
+static bool inside_comms(uint8_t *p, uint32_t bits)
+{
+	uint8_t *base = comms.jtag_tx;
+	size_t bytes = (bits + 7) / 8;
+	return p >= base && p + bytes <= base + sizeof(comms);
+}
+
+int main(void)
+{
+	int bad_discard = 0, bad_capture = 0, scans = 0;
+	size_t first_bad = 0;
+
+	// A final chunk: every length the host can send in the primary buffer, advancing state.
+	for (size_t bytes = 1; bytes <= JTAG_BUFFER_SIZE; bytes++) {
+		tap_calls = 0; tap_output = (uint8_t *)1;
+		memset(comms.jtag_tx, 0, sizeof(comms.jtag_tx));
+		bool ok = jtag_scan_from(comms.jtag_tx, bytes * 8, true, false, true);
+		if (!ok) continue;
+		scans++;
+		if (tap_calls && tap_output != NULL && !inside_comms(tap_output, tap_bits)) {
+			if (!bad_discard) first_bad = bytes;
+			bad_discard++;
+		}
+	}
+	CHECK(scans == JTAG_BUFFER_SIZE, "%d discarding final chunks of 1..%d bytes were scanned", scans, JTAG_BUFFER_SIZE);
+	CHECK(bad_discard == 0, "no discarding final chunk stores outside comms (%d do; first at %zu bytes)",
+	      bad_discard, first_bad);
+
+	// A capturing scan is limited to the read half; its tail must land inside the region.
+	for (size_t bytes = 1; bytes <= JTAG_READ_BUFFER_SIZE; bytes++) {
+		tap_calls = 0; tap_output = (uint8_t *)1;
+		if (!jtag_scan_from(comms.jtag_tx, bytes * 8, true, false, false)) continue;
+		if (tap_calls && tap_output != NULL && !inside_comms(tap_output, tap_bits)) bad_capture++;
+	}
+	CHECK(bad_capture == 0, "no capturing final chunk stores outside comms (%d do)", bad_capture);
+
+	// The case from the board: a 692-byte final chunk.
+	tap_calls = 0; tap_output = (uint8_t *)1;
+	(void)jtag_scan_from(comms.jtag_tx, 692 * 8, true, false, true);
+	CHECK(tap_calls == 1 && tap_output == NULL, "a 692-byte discarding final chunk has no tail destination");
+
+	// Every bit count, every flag combination: neither the DMA receive nor the tail may leave comms.
+	int bad_any = 0;
+	size_t first_bits = 0;
+	for (int capture = 0; capture <= 1; capture++) {
+		for (int advance = 0; advance <= 1; advance++) {
+			for (uint32_t bits = 1; bits <= 8u * JTAG_BUFFER_SIZE + 64u; bits++) {
+				tap_calls = 0; tap_output = NULL; spi_rx = NULL; spi_rx_len = 0;
+				if (!jtag_scan_from(comms.jtag_tx, bits, advance, false, !capture)) continue;
+				bool rx_bad = spi_rx && (spi_rx < comms.jtag_tx || spi_rx + spi_rx_len > comms.jtag_tx + sizeof(comms));
+				bool tail_bad = tap_calls && tap_output && !inside_comms(tap_output, tap_bits);
+				if (rx_bad || tail_bad) {
+					if (!bad_any) first_bits = bits;
+					bad_any++;
+				}
+			}
+		}
+	}
+	CHECK(bad_any == 0, "no scan of any bit count (capture or discard, advance or not) writes outside comms (%d do; first at %zu bits)",
+	      bad_any, first_bits);
+
+	// FORCE_BITBANG sends every bit through the tail: the tail must be told the full count.
+	int bad_bits = 0;
+	uint32_t first_bitbang = 0;
+	for (uint32_t bits = 1; bits <= 8u * JTAG_READ_BUFFER_SIZE; bits++) {
+		tap_calls = 0; tap_bits = 0;
+		if (!jtag_scan_from(comms.jtag_tx, bits, false, true, true)) continue;
+		if (tap_bits != bits) {
+			if (!bad_bits) first_bitbang = bits;
+			bad_bits++;
+		}
+	}
+	CHECK(bad_bits == 0, "a bitbang scan shifts every bit it was asked for (%d counts truncated; first at %u bits)",
+	      bad_bits, first_bitbang);
+
+	// No JTAG_START: no request that writes the scan buffers (the live console ring) may run.
+	{
+		const uint8_t writers[] = { VENDOR_REQUEST_JTAG_CLEAR_OUT_BUFFER, VENDOR_REQUEST_JTAG_SET_OUT_BUFFER,
+		                            VENDOR_REQUEST_JTAG_SCAN, VENDOR_REQUEST_JTAG_RUN_CLOCK,
+		                            VENDOR_REQUEST_JTAG_GOTO_STATE, VENDOR_REQUEST_JTAG_BENCHMARK };
+		int leaked = 0, blocked_in_session = 0;
+		for (unsigned i = 0; i < sizeof(writers); i++) {
+			if (jtag_request_gate(false, writers[i]) != JTAG_GATE_REFUSE) leaked++;
+			if (jtag_request_gate(true, writers[i]) != JTAG_GATE_ESCALATE) blocked_in_session++;
+		}
+		CHECK(leaked == 0, "no scan-buffer request is allowed without a session (%d are)", leaked);
+		CHECK(blocked_in_session == 0, "all of them run and escalate inside a session (%d do not)", blocked_in_session);
+		CHECK(jtag_request_gate(false, VENDOR_REQUEST_JTAG_START) == JTAG_GATE_PASS, "JTAG_START is allowed without a session");
+		CHECK(jtag_request_gate(false, VENDOR_REQUEST_GET_ID) == JTAG_GATE_PASS, "GET_ID is allowed without a session");
+	}
+
+	// The benchmark's wire time (48 MHz / (2 * (divider + 1))) stays inside half the watchdog stall budget.
+	int bad_wire = 0, accepted = 0;
+	for (unsigned units = 1; units <= 8; units++) {
+		for (unsigned repeats = 1; repeats <= 1024; repeats *= 2) {
+			for (unsigned divider = 0; divider <= 0xFF; divider++) {
+				tusb_control_request_t request = { .bRequest = 0xB9, .wValue = (uint16_t)repeats,
+				                                   .wIndex = (uint16_t)(units | (divider << 8)), .wLength = 12 };
+				if (!handle_jtag_benchmark(0, &request)) continue;
+				accepted++;
+				double div = divider == 0xFF ? 1 : divider;
+				double wire_ms = units * 64.0 * repeats * 16.0 * (div + 1) / 48000.0;
+				if (wire_ms > HANG_WD_LONGEST_STALL_MS / 2.0) bad_wire++;
+			}
+		}
+	}
+	CHECK(accepted > 0 && bad_wire == 0, "no accepted benchmark outruns the watchdog (%d of %d do)", bad_wire, accepted);
+
+	// The benchmark (0xB9) receives into jtag_in_buffer: its chunk must fit the read half.
+	int bad_bench = 0;
+	for (unsigned units = 1; units <= 255; units++) {
+		tusb_control_request_t request = { .bRequest = 0xB9, .wValue = 1, .wIndex = (uint16_t)(units | 0xFF00), .wLength = 12 };
+		spi_rx = NULL; spi_rx_len = 0;
+		(void)handle_jtag_benchmark(0, &request);
+		if (spi_rx && (spi_rx < comms.jtag_tx || spi_rx + spi_rx_len > comms.jtag_tx + sizeof(comms))) bad_bench++;
+	}
+	CHECK(bad_bench == 0, "no benchmark chunk receives outside comms (%d chunk sizes do)", bad_bench);
+
+	printf(failures ? "FAILED\n" : "all passed\n");
+	return failures != 0;
+}
diff --git a/firmware/test/test_jtag_tail.c b/firmware/test/test_jtag_tail.c
new file mode 100644
index 0000000..33a99e7
--- /dev/null
+++ b/firmware/test/test_jtag_tail.c
@@ -0,0 +1,40 @@
+/**
+ * Host-native test of where a scan's bit-banged tail stores TDO (jtag_tail.h).
+ *
+ * The tail's destination was jtag_in_buffer + slow_offset even when the scan discards TDO; with
+ * slow_offset up to the chunk length and jtag_in_buffer only the second 512 bytes of the 1024-byte
+ * region, a final chunk over 513 bytes wrote past the region (692 bytes landed on the USB control
+ * struct's callback pointer).
+ *
+ * SPDX-License-Identifier: BSD-3-Clause
+ */
+
+#include <stdio.h>
+#include <stddef.h>
+
+#include "jtag_tail.h"
+
+static int failures = 0;
+
+#define CHECK(cond, ...)                                                       \
+	do {                                                                       \
+		if (cond) { printf("  ok   - "); }                                     \
+		else { printf("  FAIL - "); failures++; }                              \
+		printf(__VA_ARGS__);                                                   \
+		printf("\n");                                                          \
+	} while (0)
+
+int main(void)
+{
+	static uint8_t region[1024];
+	uint8_t *in_buffer = region + 512;
+
+	CHECK(jtag_tail_dest(true, in_buffer, 691) == NULL, "a scan that discards TDO has no tail destination");
+	CHECK(jtag_tail_dest(true, in_buffer, 0) == NULL, "also at offset 0");
+	CHECK(jtag_tail_dest(false, in_buffer, 100) == in_buffer + 100, "a capturing scan stores at the offset");
+	CHECK(jtag_tail_dest(false, in_buffer, 511) < region + sizeof(region),
+	      "a capturing scan's last allowed offset (511, JTAG_READ_BUFFER_SIZE - 1) stays inside the region");
+
+	printf(failures ? "FAILED\n" : "all passed\n");
+	return failures != 0;
+}
